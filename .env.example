# Supabase Dashboard -> Connect (top right) -> Project URL
# In Integrations -> Data API, remove /rest/v1 if copying the API URL there.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Supabase Dashboard -> Settings -> API Keys -> Publishable key
# This is the public mobile-app key. Never use a secret/service_role key here.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY
